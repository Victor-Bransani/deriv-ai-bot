# Copie para `.env` na VPS. Docker: docker run --env-file .env

DERIV_APP_ID=1089
DERIV_TOKEN=
DERIV_DEMO=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# true = na subida já busca sinais (sem precisar Iniciar no Telegram)
AUTO_START_TRADING=false

# Ajustes Kelly também pelo Telegram: /kelly (gravados em user_settings.json)

# Kelly (opcional; ver config.py)
# KELLY_ENABLED=true
# KELLY_FRACTION=0.25
# KELLY_WINDOW=80
# KELLY_MIN_TRADES=12
# KELLY_DEFAULT_WIN_PAYOFF=1.5

# Multiplicadores (MULTUP/MULTDOWN)
# CURRENCY=USD
# MULTIPLIER=100
# TAKE_PROFIT_PCT=1.50
# STOP_LOSS_PCT=0.50
# MAX_STAKE_PCT=0.01
# MAX_STAKE=500
# GHOST_TRADE_TIMEOUT_SEC=3600
# CONTRACT_RESULT_MAX_WAIT=7200

# TP/SL diário (% da banca na abertura do dia). 0 = desligado
# TP_DAILY_PCT=0.05
# SL_DAILY_PCT=0.10

# Operário → gestor (python telegram_manager.py em :8000)
# MANAGER_WEBHOOK_URL=http://127.0.0.1:8000/alert

# Gestor: URLs dos 4 operários (main.py com PORT diferente por instância)
# WORKER_V10_URL=http://127.0.0.1:8081
# WORKER_V25_URL=http://127.0.0.1:8082
# WORKER_V50_URL=http://127.0.0.1:8083
# WORKER_V75_URL=http://127.0.0.1:8084
# MANAGER_PORT=8000
# CSV dos operários para /api/trades (predef.: pasta DATA_DIR do config)
# DASHBOARD_DATA_DIR=data

# Logs e dados (ML)
# LOG_LEVEL=INFO
# BOT_LOG_FILE=logs/bot.log
# DATA_DIR=data
# TICK_CSV_ENABLED=true
# CYCLE_CSV_ENABLED=true
# TICK_QUEUE_MAX=100000
# IDLE_TRADING_LOG_INTERVAL_SEC=300
