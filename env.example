# Copie para `.env` na VPS. Docker: docker run --env-file .env

DERIV_APP_ID=1089
DERIV_TOKEN=
DERIV_DEMO=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# true = na subida já busca sinais (sem precisar Iniciar no Telegram)
AUTO_START_TRADING=false

# Ajustes Kelly também pelo Telegram: /kelly (gravados em user_settings.json)

# Kelly (opcional; ver config.py)
# KELLY_ENABLED=true
# KELLY_FRACTION=0.25
# KELLY_WINDOW=80
# KELLY_MIN_TRADES=12
# KELLY_DEFAULT_WIN_PAYOFF=1.5

# Multiplicadores (MULTUP/MULTDOWN)
# CURRENCY=USD
# MULTIPLIER=100
# TAKE_PROFIT_PCT=1.50
# STOP_LOSS_PCT=0.50
# MAX_STAKE_PCT=0.01
# MAX_STAKE=500
# GHOST_TRADE_TIMEOUT_SEC=3600
# CONTRACT_RESULT_MAX_WAIT=7200

# TP/SL diário (% da banca na abertura do dia). 0 = desligado
# TP_DAILY_PCT=0.05
# SL_DAILY_PCT=0.10
